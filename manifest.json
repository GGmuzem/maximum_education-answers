{
  "manifest_version": 3,
  "name": "AutoTestAnswer",
  "version": "1.5",
  "description": "Автоматически подставляет правильный ответ из JSON",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://education.maximumtest.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://education.maximumtest.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
